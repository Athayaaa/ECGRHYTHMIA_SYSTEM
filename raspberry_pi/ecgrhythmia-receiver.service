[Unit]
Description=ECGRHYTHMIA receiver service
Documentation=file:/home/athaya/Projects/ECGRHYTHMIA_SYSTEM/raspberry_pi/DOCUMENTATION.md
After=default.target

[Service]
Type=simple
WorkingDirectory=/home/athaya/Projects/ECGRHYTHMIA_SYSTEM/raspberry_pi
EnvironmentFile=/home/athaya/Projects/ECGRHYTHMIA_SYSTEM/raspberry_pi/runtime/current_session.env
ExecStart=/home/athaya/Projects/ECGRHYTHMIA_SYSTEM/raspberry_pi/venv/bin/python /home/athaya/Projects/ECGRHYTHMIA_SYSTEM/raspberry_pi/receiver.py --config /home/athaya/Projects/ECGRHYTHMIA_SYSTEM/raspberry_pi/config.yaml --output-dir ${SESSION_DIR} --no-gui
Restart=on-failure
RestartSec=3
TimeoutStopSec=8
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target

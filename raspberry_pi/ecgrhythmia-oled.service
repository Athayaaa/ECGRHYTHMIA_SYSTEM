[Unit]
Description=ECGRHYTHMIA read-only OLED status display
Documentation=file:/home/athaya/Projects/ECGRHYTHMIA_SYSTEM/raspberry_pi/OLED_STATUS_GUIDE.md
# Start after the base system is ready. This service is INDEPENDENT of the
# receiver: it never touches serial, firmware, GUI, AI engine, or ECG data.
# The receiver is unaffected if this unit fails.
After=multi-user.target

[Service]
Type=simple
User=athaya
WorkingDirectory=/home/athaya/Projects/ECGRHYTHMIA_SYSTEM/raspberry_pi
ExecStart=/home/athaya/Projects/ECGRHYTHMIA_SYSTEM/raspberry_pi/venv_oled/bin/python /home/athaya/Projects/ECGRHYTHMIA_SYSTEM/raspberry_pi/oled_status.py
# Restart only on OLED app failures; does not affect any other program.
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

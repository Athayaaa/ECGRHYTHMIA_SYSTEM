[Unit]
Description=ECGRHYTHMIA MQTT publisher service
Documentation=file:/home/athaya/Projects/ECGRHYTHMIA_SYSTEM/raspberry_pi/DOCUMENTATION.md
After=ecgrhythmia-ai.service

[Service]
Type=simple
WorkingDirectory=/home/athaya/Projects/ECGRHYTHMIA_SYSTEM/raspberry_pi
Environment=MQTT_BROKER=localhost
Environment=MQTT_PORT=1883
Environment=MQTT_TOPIC=ecgrhythmia/device01/frame
Environment=MQTT_DEVICE_ID=device01
EnvironmentFile=/home/athaya/Projects/ECGRHYTHMIA_SYSTEM/raspberry_pi/runtime/current_session.env
EnvironmentFile=-/home/athaya/Projects/ECGRHYTHMIA_SYSTEM/raspberry_pi/runtime/mqtt_credentials.env
ExecStart=/bin/bash -lc 'args=(--ecg-dir "$CALIBRATED_DIR" --prediction-dir "$PREDICTION_DIR" --broker "$MQTT_BROKER" --port "$MQTT_PORT" --topic "$MQTT_TOPIC" --device-id "$MQTT_DEVICE_ID" --follow); if [ -n "${MQTT_USERNAME:-}" ]; then args+=(--username "$MQTT_USERNAME" --password-env MQTT_PASSWORD); fi; exec /home/athaya/Projects/ECGRHYTHMIA_SYSTEM/raspberry_pi/venv/bin/python /home/athaya/Projects/ECGRHYTHMIA_SYSTEM/raspberry_pi/mqtt_publisher.py "${args[@]}"'
Restart=on-failure
RestartSec=3
TimeoutStopSec=8
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
